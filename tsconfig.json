{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": { "@kateter/viz": ["./src/index.ts"], "@kateter/viz/core": ["./src/core.ts"], "@kateter/viz/spec": ["./src/spec.ts"] },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "gallery", "catalogue", "specpreview", "artifacts", "pages", "designlab", "tests"]
}
